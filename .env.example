# Set these in your hosting provider's environment settings.
# The server does not load .env files automatically.

# Your Holded API key, as is (Holded → Settings → Developers).
HOLDED_API_KEY=replace_with_your_holded_api_key

# SHA-256 hex digest of the access key clients send as `Authorization: Bearer <key>`.
# Generate a key and its hash with: holded-mcp --generate-key
MCP_API_KEY_HASH=replace_with_sha256_hex_of_your_access_key

# Optional.
# PORT=8000
# HOLDED_READ_ONLY=false
