# Set these in your hosting provider's environment settings.
# The server does not load .env files automatically.

# Your Holded API key, as is (Holded → Settings → Developers).
HOLDED_API_KEY=replace_with_your_holded_api_key

# PBKDF2 hash of the password asked for when an MCP client connects (OAuth login page).
# Generate it with: holded-mcp --hash-password
MCP_PASSWORD_HASH=replace_with_output_of_holded_mcp_hash_password

# Public URL of this server, used as the OAuth issuer. Railway's domain is detected
# automatically from RAILWAY_PUBLIC_DOMAIN; set this for a custom domain.
# MCP_PUBLIC_URL=https://mcp.example.com

# Optional.
# PORT=8000
# HOLDED_READ_ONLY=false
